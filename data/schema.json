{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChrisHKAI/awesome-6.2-sol-videos/data/schema.json",
  "title": "Awesome 6.2 Sol Videos catalog",
  "type": "object",
  "required": ["schema_version", "name", "model", "provenance", "counts", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "name": {"const": "Awesome 6.2 Sol Videos"},
    "language": {"const": "zh-Hant"},
    "model": {
      "type": "object",
      "required": ["community_name", "official_status", "statement_zh"],
      "properties": {
        "community_name": {"const": "GPT-6.2 Sol"},
        "also_seen_as": {"type": "array", "items": {"type": "string"}},
        "official_status": {"const": "unconfirmed"},
        "statement_zh": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {"type": "object"},
    "counts": {"type": "object"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "role",
        "counts_as_gallery",
        "title_zh",
        "title_en",
        "author_handle",
        "author_url",
        "post_url",
        "post_type",
        "quoted_author_handle",
        "created_at_utc",
        "created_at_shanghai",
        "gallery_category",
        "tech_tags",
        "tech_evidence",
        "comparison",
        "prompt",
        "media",
        "metrics_snapshot",
        "attribution",
        "seed_summary",
        "exclusion_reason_zh",
        "unknowns"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]+$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "role": {
          "enum": [
            "gallery",
            "counterexample_visual",
            "uncertain",
            "retelling",
            "detection",
            "cost_quota",
            "opinion",
            "rumor",
            "roundup",
            "official_non_model",
            "irrelevant"
          ]
        },
        "counts_as_gallery": {"type": "boolean"},
        "post_url": {"type": "string", "pattern": "^https://x\\.com/"},
        "created_at_shanghai": {"type": "string", "pattern": "Asia/Shanghai\\(UTC\\+8\\)$"},
        "gallery_category": {
          "anyOf": [
            {"enum": ["threejs", "3d-scene", "animation", "drawing-svg", "comparison"]},
            {"type": "null"}
          ]
        },
        "tech_tags": {"type": "array", "items": {"type": "string"}},
        "tech_evidence": {"enum": ["seed_summary", "seed_tag", "not_stated"]},
        "prompt": {
          "type": "object",
          "required": ["status", "exact_public_text", "file", "title_mentioned", "note_zh"],
          "properties": {
            "status": {
              "enum": [
                "unavailable",
                "named_only",
                "mentioned_not_archived",
                "not_a_generation_prompt",
                "exact_public",
                "partial_public"
              ]
            },
            "exact_public_text": {"type": ["string", "null"]},
            "file": {"type": ["string", "null"]},
            "title_mentioned": {"type": ["string", "null"]}
          }
        },
        "media": {
          "type": "object",
          "required": ["archived", "preview_url"],
          "properties": {
            "archived": {"type": "boolean"},
            "preview_url": {"type": ["string", "null"]}
          }
        },
        "attribution": {
          "type": "object",
          "required": ["model_name_status", "routing_claim", "official_release", "note_zh"],
          "properties": {
            "official_release": {"const": false},
            "model_name_status": {
              "enum": [
                "unconfirmed_community_name",
                "official_post_not_a_model_announcement",
                "not_about_this_model"
              ]
            },
            "routing_claim": {"enum": ["user_reported_unverified", "not_applicable"]}
          }
        },
        "metrics_snapshot": {
          "type": "object",
          "required": ["views", "likes", "bookmarks", "retweets", "quotes", "replies", "captured_at"],
          "properties": {
            "views": {"type": ["integer", "null"]},
            "likes": {"type": ["integer", "null"]},
            "bookmarks": {"type": ["integer", "null"]},
            "retweets": {"type": ["integer", "null"]},
            "quotes": {"type": ["integer", "null"]},
            "replies": {"type": ["integer", "null"]}
          }
        },
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
